generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
}

model Order {
  id        String  @id @default(cuid())
  sessionId String  @unique
  paid      Boolean @default(false)
}
